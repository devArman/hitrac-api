// HiTrack API — свои таблицы (префикс ht_) в общей базе `hitrac` рядом с tc_* Traccar-а.
// Правило: tc_* таблицы этой схемой НЕ описываем и не мигрируем — они принадлежат Traccar.

generator client {
  provider      = "prisma-client-js"
  // native — для локальной разработки, debian-openssl-3.0.x — рантайм в node:22-slim
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model HtRole {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  // строки-права, например "users:manage", "devices:read"; "*" — все права
  permissions String[] @default([])
  users       HtUser[]

  @@map("ht_roles")
}

model HtUser {
  id           Int            @id @default(autoincrement())
  email        String         @unique
  name         String
  phone        String?
  prefs        Json?
  passwordHash String         @map("password_hash")
  disabled     Boolean        @default(false)
  roleId       Int?           @map("role_id")
  role         HtRole?        @relation(fields: [roleId], references: [id])
  devices      HtUserDevice[]
  groups       HtGroupUser[]
  announcements     HtAnnouncementUser[]
  announcementReads HtAnnouncementRead[]
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@map("ht_users")
}

// какие Traccar-устройства видит пользователь (наша карта прав вместо tc_user_device/групп)
model HtUserDevice {
  id       Int    @id @default(autoincrement())
  userId   Int    @map("user_id")
  deviceId Int    @map("device_id")
  user     HtUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@map("ht_user_devices")
}

// группа: пачка устройств + пачка пользователей; каждый пользователь группы видит все её устройства
model HtGroup {
  id          Int             @id @default(autoincrement())
  name        String          @unique
  description String?
  devices       HtGroupDevice[]
  users         HtGroupUser[]
  announcements HtAnnouncementGroup[]
  createdAt     DateTime        @default(now()) @map("created_at")

  @@map("ht_groups")
}

model HtGroupDevice {
  id       Int     @id @default(autoincrement())
  groupId  Int     @map("group_id")
  deviceId Int     @map("device_id")
  group    HtGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, deviceId])
  @@map("ht_group_devices")
}

// объявление: всем (toAll), группам и/или конкретным пользователям; reads — кто прочитал
model HtAnnouncement {
  id        Int                     @id @default(autoincrement())
  subject   String
  body      String
  toAll     Boolean                 @default(false) @map("to_all")
  createdBy Int?                    @map("created_by")
  createdAt DateTime                @default(now()) @map("created_at")
  groups    HtAnnouncementGroup[]
  users     HtAnnouncementUser[]
  reads     HtAnnouncementRead[]

  @@map("ht_announcements")
}

model HtAnnouncementGroup {
  id             Int            @id @default(autoincrement())
  announcementId Int            @map("announcement_id")
  groupId        Int            @map("group_id")
  announcement   HtAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  group          HtGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([announcementId, groupId])
  @@map("ht_announcement_groups")
}

model HtAnnouncementUser {
  id             Int            @id @default(autoincrement())
  announcementId Int            @map("announcement_id")
  userId         Int            @map("user_id")
  announcement   HtAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           HtUser         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@map("ht_announcement_users")
}

model HtAnnouncementRead {
  id             Int            @id @default(autoincrement())
  announcementId Int            @map("announcement_id")
  userId         Int            @map("user_id")
  readAt         DateTime       @default(now()) @map("read_at")
  announcement   HtAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           HtUser         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@map("ht_announcement_reads")
}

// тарировка ДУТ конкретного устройства: points = [{raw, liters}, …] по возрастанию raw
model HtFuelCalibration {
  id        Int      @id @default(autoincrement())
  deviceId  Int      @unique @map("device_id")
  sensorKey String   @default("io270") @map("sensor_key")
  points    Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("ht_fuel_calibrations")
}

// лимиты, заданные клиентом на устройство; fuel_alerted — защита от спама уведомлениями
model HtDeviceSetting {
  id            Int      @id @default(autoincrement())
  deviceId      Int      @unique @map("device_id")
  speedLimitKmh Float?   @map("speed_limit_kmh")
  minFuelLiters Float?   @map("min_fuel_liters")
  fuelAlerted   Boolean  @default(false) @map("fuel_alerted")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("ht_device_settings")
}

// наши автоматические уведомления (низкий остаток топлива и т.п.)
model HtAlert {
  id        Int      @id @default(autoincrement())
  deviceId  Int      @map("device_id")
  type      String
  message   String
  value     Float?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([deviceId, createdAt])
  @@map("ht_alerts")
}

// владелец геозоны: null — общая для всех клиентов
model HtGeofenceMeta {
  id          Int      @id @default(autoincrement())
  geofenceId  Int      @unique @map("geofence_id")
  ownerUserId Int?     @map("owner_user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("ht_geofence_meta")
}

model HtGroupUser {
  id      Int     @id @default(autoincrement())
  groupId Int     @map("group_id")
  userId  Int     @map("user_id")
  group   HtGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user    HtUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("ht_group_users")
}
